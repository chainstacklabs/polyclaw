# PolyClaw configuration template
# Copy to .env and fill in your values:  cp .env.example .env
#
# Lines starting with # are comments and are ignored.
# Boolean values: true / false

# =============================================================================
# MODE
# =============================================================================

# Simulate all trades without real blockchain calls.
# Positions are stored with paper=true so you can track simulated P&L.
# Use this to validate the algorithm before risking real capital.
PAPER_TRADING=true

# =============================================================================
# WALLET / BLOCKCHAIN  (required for live trading)
# =============================================================================

# Your EVM private key (with or without 0x prefix).
# Keep this secret — never commit to git.
POLYCLAW_PRIVATE_KEY=

# Polygon RPC endpoint.
# Free node: https://console.chainstack.com  (sign up, create Polygon node)
CHAINSTACK_NODE=

# =============================================================================
# LLM  (required for hedge/arb scanning)
# =============================================================================

# API key for the LLM provider.
# OpenRouter (cloud, free tier available): https://openrouter.ai/keys
# Local Ollama: set to "ollama"
OPENROUTER_API_KEY=

# LLM API base URL.
# Default (OpenRouter): https://openrouter.ai/api/v1
# Local Ollama:         http://localhost:11434/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM model to use for implication analysis.
# Cloud (free via OpenRouter):
#   nvidia/nemotron-nano-9b-v2:free   fast, good JSON output (default)
#   deepseek/deepseek-r1:free         strong reasoning, slower
# Local Ollama:
#   qwen3:14b                         best balance speed/quality (~10GB RAM)
#   qwen3:32b                         higher quality (~20GB RAM)
#   llama3.3:70b                      top quality (~40GB RAM)
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free

# LLM request timeout (seconds)
LLM_TIMEOUT=60

# LLM retry attempts on rate limit / network error
LLM_MAX_RETRIES=3

# =============================================================================
# API SETTINGS
# =============================================================================

# Gamma API (Polymarket market data)
GAMMA_TIMEOUT=30
GAMMA_MAX_RETRIES=3

# CLOB (order execution) — retries for Cloudflare rotation
CLOB_MAX_RETRIES=5

# Optional: rotating proxy for CLOB (bypasses Cloudflare IP blocks)
# Format: http://user:pass@host:port  or  socks5://host:port
# HTTPS_PROXY=

# Default max slippage for CLOB sells (fraction).
# 0.10 = accept up to 10% below market price.
DEFAULT_SLIPPAGE=0.10

# =============================================================================
# POSITION SIZING
# =============================================================================

# Use Kelly criterion for automatic position sizing.
# When true, DEFAULT_AMOUNT is ignored.
# When false, DEFAULT_AMOUNT is used for every trade.
USE_KELLY_SIZING=false

# Fraction of full Kelly to apply (0.0–1.0).
# Full Kelly (1.0) is mathematically optimal but very aggressive.
# Quarter Kelly (0.25) is conservative and recommended for bots.
# Half Kelly (0.50) is a common compromise.
KELLY_FRACTION=0.25

# Fixed USD amount per leg when USE_KELLY_SIZING=false.
# Total capital per arb = DEFAULT_AMOUNT × 2
DEFAULT_AMOUNT=50

# Hard cap on USD per leg, regardless of Kelly or other sizing.
# Prevents oversized positions from model overconfidence.
MAX_POSITION=500

# =============================================================================
# DAEMON (24/7 scanning)
# =============================================================================

# Minutes between arb scans.
# More frequent = faster reaction but more LLM API calls.
DAEMON_SCAN_INTERVAL=15

# Automatically execute found arb opportunities.
# false = alert only (recommended while testing / in PAPER_TRADING mode)
# true  = execute best opportunity each scan
DAEMON_AUTO_EXECUTE=false

# Minimum guaranteed profit fraction to consider an opportunity.
# 0.05 = require at least 5% profit.
# Lower value = more opportunities but higher noise.
DAEMON_MIN_PROFIT=0.05

# Maximum USD to spend across all trades in a calendar day (resets at midnight UTC).
DAEMON_DAILY_BUDGET=500

# Number of markets fetched per scan.
# More = more opportunities found, but slower and more LLM calls.
DAEMON_SCAN_LIMIT=30

# Optional keyword to filter scanned markets (e.g. "election", "bitcoin").
# Leave empty to scan all trending markets by volume.
DAEMON_QUERY=

# =============================================================================
# NOTIFICATIONS  (configure at least one for 24/7 alerting)
# =============================================================================

# ntfy.sh push notifications — simplest option, no account needed.
# 1. Install ntfy app on your phone: https://ntfy.sh
# 2. Set a unique secret topic name (acts as a password)
# 3. Subscribe to the same topic in the app
DAEMON_NTFY_URL=https://ntfy.sh/change-this-to-a-secret-topic

# Telegram bot notifications.
# 1. Create bot: message @BotFather on Telegram, use /newbot
# 2. Get your chat ID: message @userinfobot
DAEMON_TELEGRAM_TOKEN=
DAEMON_TELEGRAM_CHAT_ID=

# Generic JSON webhook (Slack, Discord, custom endpoint).
# Payload sent: {"title": "...", "message": "...", "text": "..."}
DAEMON_WEBHOOK_URL=
